<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
     <link rel="icon" type="image/png" href="/images/favicon.png">
    <meta charset="UTF-8">
    <title>قارئ الكتب الآمن - <%= book.title %></title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #333;
            font-family: sans-serif;
            overflow: hidden;
            user-select: none; /* منع تحديد النصوص */
            -webkit-user-select: none;
        }
        .viewer-header {
            background-color: #111;
            color: #fff;
            padding: 10px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            height: 30px; /* تحديد ارتفاع ثابت للهيدر */
        }
        .viewer-header h2 { margin: 0; font-size: 18px; }
        .close-btn { color: #ccc; text-decoration: none; font-weight: bold; }
        
        /* 1. حاوية الـ iframe لمنع الخروج والمشاركة */
        .pdf-container {
            position: relative;
            width: 100%;
            height: calc(100vh - 50px);
            overflow: hidden;
        }

        /* 2. الطبقة الشفافة لحجب النقرات عن شريط قوقل درايف العلوي */
        .protection-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 60px; /* هذا الارتفاع يغطي الأزرار العلوية لقوقل درايف بالكامل */
            background: transparent;
            z-index: 999; /* لجعلها فوق الـ iframe دائماً */
            cursor: default;
        }

        iframe {
            border: none;
            width: 100%;
            height: 100%;
        }
    </style>
</head>
<body>

    <div class="viewer-header">
        <h2>أنت تقرأ الآن كتاب: <%= book.title %> (العرض محمي )</h2>
        <a href="javascript:window.close();" class="close-btn">إغلاق القارئ ✖</a>
    </div>

    <div class="pdf-container">
        <div class="protection-overlay"></div>
        <iframe src="<%= book.pdf_url %>#toolbar=0" oncontextmenu="return false;"></iframe>
    </div>

    <script>
        // 1. منع القائمة المنبثقة للزر الأيمن
        document.addEventListener('contextmenu', function(e) {
            e.preventDefault();
            alert("عذراً، تنزيل أو طباعة الكتب غير مسموح لحماية حقوق الملكية.");
        });

        // 2. منع اختصارات الحفظ والطباعة وتصوير الشاشة وسورس الكود
        document.addEventListener('keydown', function(e) {
            if (e.ctrlKey && (e.key === 's' || e.key === 'p' || e.key === 'u' || e.key === 'c' || e.key === 'a')) {
                e.preventDefault();
                alert("هذا الإجراء محظور داخل قارئ الكتب الآمن.");
            }
            if (e.key === 'F12' || (e.ctrlKey && e.shiftKey && e.key === 'I')) {
                e.preventDefault();
                alert("أدوات المطور معطلة لحماية المحتوى.");
            }
        });
         // 1. منع القائمة المنبثقة عند الضغط كليك يمين (Context Menu)
    document.addEventListener('contextmenu', function(e) {
        e.preventDefault();
    });

    // 2. منع اختصارات لوحة المفاتيح الشهيرة لفتح أدوات المطورين
    document.addEventListener('keydown', function(e) {
        // منع F12
        if (e.key === 'F12') {
            e.preventDefault();
            return false;
        }
        
        // منع Ctrl + Shift + I (فتح الـ Inspect)
        if (e.ctrlKey && e.shiftKey && e.key === 'I') {
            e.preventDefault();
            return false;
        }

        // منع Ctrl + Shift + J (فتح الـ Console)
        if (e.ctrlKey && e.shiftKey && e.key === 'J') {
            e.preventDefault();
            return false;
        }

        // منع Ctrl + U (عرض السورس كود الخاص بالصفحة)
        if (e.ctrlKey && e.key === 'u') {
            e.preventDefault();
            return false;
        }

        // منع Ctrl + S (لحماية الملفات من الحفظ المباشر)
        if (e.ctrlKey && e.key === 's') {
            e.preventDefault();
            return false;
        }
    });
        
    
    </script>
   
   

</body>
</html>