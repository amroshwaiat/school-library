<body>
    <div class="container">
        <a href="/books/admin" class="back-link">← العودة للوحة التحكم الرئيسية</a>

        <div class="section-box">
            <h2>إضافة كتاب تعليمي جديد لمستودع BTEC ➕</h2>
            <form action="/books/add" method="POST">
                <div class="form-grid">
                    <div class="form-group">
                        <label>عنوان الكتاب/الملف:</label>
                        <input type="text" name="title" required placeholder="مثال: هندسة البرمجيات المتقدمة">
                    </div>
                    
                    <div class="form-group">
                        <label>القسم (التصنيف):</label>
                        <select name="category_id" required>
                            <option value="">اختر القسم...</option>
                            <% categories.forEach(cat => { %>
                                <option value="<%= cat.id %>"><%= cat.name %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>المستوى الفني (Level):</label>
                        <select name="level" required>
                            <option value="">اختر المستوى...</option>
                            <option value="Level 2">المستوى الثاني (L2)</option>
                            <option value="Level 3">المستوى الثالث (L3)</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>رمز/اسم المادة الفنية:</label>
                        <input type="text" name="subject_id" placeholder="مثال: btec_soft101">
                    </div>
                    
                    <div class="form-group">
                        <label>رابط الصورة المباشر (اختياري):</label>
                        <input type="text" name="image_url" placeholder="https://example.com/image.jpg">
                    </div>
                    
                    <div class="form-group">
                        <label>رابط ملف الـ PDF للمادة:</label>
                        <input type="url" name="pdf_url" required placeholder="أدخل رابط الملف من Google Drive">
                    </div>
                </div>
                <button type="submit" class="btn-submit">حفظ وإضافة الكتاب فوراً 🚀</button>
            </form>
        </div>

        <div class="section-box">
            <h2>قائمة الكتب الحالية في النظام 📚</h2>
            <input type="text" id="bookSearch" class="search-box" onkeyup="filterBooks()" placeholder="🔍 ابدأ بكتابة اسم الكتاب للبحث الفوري والسريع...">
            
            <table class="books-table" id="booksTable">
                <thead>
                    <tr>
                        <th style="text-align: right;">عنوان الكتاب</th>
                        <th>القسم العلمي</th>
                        <th>المستوى (Level)</th>
                        <th>المادة (Subject)</th>
                        <th>ملف الـ PDF</th>
                        <th>العمليات</th>
                    </tr>
                </thead>
                <tbody>
                    <% books.forEach(book => { %>
                        <tr>
                            <td style="font-weight: bold; text-align: right;"><%= book.title %></td>
                            
                            <td><span class="badge-cat"><%= book.category_name || 'عام' %></span></td>
                            
                            <td>
                                <% if(book.level) { %>
                                    <span class="badge-level"><%= book.level %></span>
                                <% } else { %>
                                    <span style="color:#aaa; font-size:12px;">غير محدد</span>
                                <% } %>
                            </td>

                            <td>
                                <% if(book.subject_id) { %>
                                    <span class="badge-subject"><%= book.subject_id %></span>
                                <% } else { %>
                                    <span style="color:#aaa; font-size:12px;">-</span>
                                <% } %>
                            </td>
                            
                            <td><a href="<%= book.pdf_url %>" target="_blank" style="color: #e74c3c; text-decoration: none; font-weight: bold;">📄 عرض الملف</a></td>
                            
                            <td>
                                <a href="/books/delete/<%= book.id %>" onclick="return confirm('هل أنت متأكد من حذف هذا الكتاب نهائياً؟')" style="text-decoration: none; color: #e74c3c; font-size: 15px;">🗑️ حذف</a>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <script>
    // دالة تصفية والبحث في الكتب بسرعة بدون تحميل الصفحة
