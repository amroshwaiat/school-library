<body>
    <header>
        <h1>لوحة تحكم مدير المكتبة ⚙️</h1>
        <a href="/" style="color: white;text-decoration: none;">الموقع العام</a>  <a href="/admin/users" style="color: white;text-decoration: none;">إدارة الحسابات</a>  <a href="/auth/logout" style="color: white;text-decoration: none;">تسجيل الخروج</a>
    </header>

    <div class="admin-container">
        <main class="main-content">
            <section class="form-section" style="background: #f9f9f9; padding: 20px; border-radius: 8px; border: 1px solid #eee; margin-bottom: 20px;">
                <h3>إضافة كتاب جديد للموقع</h3>
                <form action="/books/add" method="POST">
                    <div class="form-group">
                        <label>عنوان الكتاب:</label>
                        <input type="text" name="title" placeholder="عنوان الكتاب أو الرواية" required>
                    </div>
                    <div class="form-group">
                        <label> رابط الـ PDF للمعاينة لازم ينتهي ب preview: </label>
                        <input type="text" name="pdf_url" placeholder="رابط الملف المخصص للمعاينة فقط" required>
                    </div>
                    <div class="form-group">
                        <label>رابط صورة غلاف الكتاب:</label>
                        <input type="text" name="image_url" placeholder="رابط صورة غلاف الكتاب" >
                    </div>
                    
                    <div class="form-group">
                        <label>قسم الكتاب العلمي: </label>
                        <select name="category_id" required>
                            <option value="">-- اختر القسم العلمي السليم --</option>
                            <% categories.forEach(cat => { %>
                                <option value="<%= cat.id %>"><%= cat.name %></option>
                            <% }) %>
                        </select>
                    </div>

                    <label class="checkbox-container">
                        <input type="checkbox" name="is_teacher_only" value="true"> 
                        <span>جعل هذا الكتاب ظاهراً للمعلمين فقط</span>
                    </label>

                    <button type="submit" style="background:#27ae60; color:white; border:none; padding:10px 20px; border-radius:4px; font-weight:bold; cursor:pointer; width:100%;">إضافة وحفظ في قاعدة البيانات</button>
                </form>
            </section>
            <table>
    <thead>
        <tr>
            <th>الاسم</th>
            <th>الصلاحية الحالية</th>
            <th>تغيير الصلاحية</th>
            <th>إجراءات</th>
        </tr>
    </thead>
    
</table>

            <h2>إدارة جميع الكتب الحالية</h2>
            <table class="admin-table" style="width: 100%; border-collapse: collapse; margin-top: 15px;">
                <thead>
                    <tr style="background: #2c3e50; color: white;">
                        <th style="padding: 10px;">اسم الكتاب</th>
                        <th style="padding: 10px;">القسم العلمي</th>
                        <th style="padding: 10px;">الفئة</th>
                        <th style="padding: 10px;">العمليات</th>
                    </tr>
                </thead>
                <tbody>
                    <% books.forEach(book => { %>
                        <tr style="border-bottom: 1px solid #ddd; text-align: center;">
                            <td style="padding: 10px;"><%= book.title %></td>
                            <td style="padding: 10px;"><b style="color: #2980b9;"><%= book.category_name || 'غير مصنف' %></b></td>
                            <td style="padding: 10px;"><%= book.is_teacher_only ? 'معلمين فقط' : 'عام للجميع' %></td>
                            <td style="padding: 10px;">
                                <button onclick="openEditModal('<%= book.id %>', '<%= book.title %>', '<%= book.pdf_url %>', '<%= book.image_url %>', <%= book.is_teacher_only %>, '<%= book.category_id || '' %>')" style="background: #f39c12; color:white; border:none; padding:5px 10px; border-radius:4px; cursor:pointer;">تعديل 📝</button>
                                <a href="/books/delete/<%= book.id %>" onclick="return confirm('هل أنت متأكد؟')" style="background: #e74c3c; color:white; padding:5px 10px; text-decoration:none; border-radius:4px; display:inline-block;">حذف 🗑️</a>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </main>

        <aside class="side-panel">
            <h3>إدارة الأقسام (BTEC)</h3>
            <form action="/books/categories/add" method="POST" style="margin-bottom: 15px;">
                <input type="text" name="category_name" placeholder="اسم القسم الجديد..." style="width:65%; padding:6px; border:1px solid #ccc; border-radius:4px;" required>
                <button type="submit" style="padding:6px 12px; background:#27ae60; color:white; border:none; border-radius:4px; cursor:pointer; font-weight:bold;">إضافة</button>
            </form>

            <table class="mini-table">
                <thead>
                    <tr style="background: #f2f2f2;">
                        <th>اسم القسم</th>
                        <th>العمليات</th>
                    </tr>
                </thead>
                <tbody>
                    <% categories.forEach(cat => { %>
                        <tr>
                            <td><%= cat.name %></td>
                            <td>
                                <button onclick="openEditCategoryModal('<%= cat.id %>', '<%= cat.name %>')" style="background:none; border:none; cursor:pointer; color:#f39c12; font-size:16px;">✏️</button>
                                <a href="/books/categories/delete/<%= cat.id %>" onclick="return confirm('حذف القسم سيؤدي لإزالة تصنيف الكتب المرتبطة به، هل أنت متأكد؟')" style="text-decoration:none; color:#e74c3c; font-size:14px; margin-right:5px;">🗑️</a>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </aside>
        
    </div>

    <div id="editModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 1000; justify-content: center; align-items: center;">
        <div style="background: white; padding: 25px; border-radius: 12px; width: 450px; direction: rtl; box-shadow: 0 4px 15px rgba(0,0,0,0.2);">
            <h3>تعديل بيانات الكتاب</h3>
            <form id="editForm" action="/books/edit" method="POST">
                <input type="hidden" name="id" id="edit_id">
                <div class="form-group">
                    <label>عنوان الكتاب:</label>
                    <input type="text" name="title" id="edit_title" required>
                </div>
                <div class="form-group">
                    <label>رابط الـ PDF للمعاينة:</label>
                    <input type="text" name="pdf_url" id="edit_pdf_url" required>
                </div>
                <div class="form-group">
                    <label>رابط غلاف الكتاب:</label>
                    <input type="text" name="image_url" id="edit_image_url" >
                </div>
                <div class="form-group">
                    <label>القسم العلمي:</label>
                    <select name="category_id" id="edit_category_id" required>
                        <% categories.forEach(cat => { %>
                            <option value="<%= cat.id %>"><%= cat.name %></option>
                        <% }) %>
                    </select>
                </div>
                
                <label class="checkbox-container">
                    <input type="checkbox" name="is_teacher_only" id="edit_is_teacher_only" value="true"> 
                    <span>جعل هذا الكتاب ظاهراً للمعلمين فقط</span>
                </label>
                
                <div style="text-align: left; margin-top: 20px;">
                    <button type="button" onclick="closeEditModal()" style="background:#95a5a6; color:white; border:none; padding:8px 15px; border-radius:4px; cursor:pointer; font-weight:bold; margin-left:5px;">إلغاء</button>
                    <button type="submit" style="background:#27ae60; color:white; border:none; padding:8px 15px; border-radius:4px; cursor:pointer; font-weight:bold;">حفظ التعديلات</button>
                </div>
            </form>
        </div>
    </div>

    <div id="editCategoryModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 1000; justify-content: center; align-items: center;">
        <div style="background: white; padding: 20px; border-radius: 8px; width: 300px; direction: rtl; box-shadow: 0 4px 15px rgba(0,0,0,0.2);">
            <h3>تعديل اسم القسم</h3>
            <form action="/books/categories/edit" method="POST">
                <input type="hidden" name="id" id="edit_cat_id">
                <div class="form-group">
                    <input type="text" name="name" id="edit_cat_name" required>
                </div>
                <div style="text-align: left; margin-top: 15px;">
                    <button type="button" onclick="closeEditCatModal()" style="background:#95a5a6; color:white; border:none; padding:6px 12px; border-radius:4px; cursor:pointer;">إلغاء</button>
                    <button type="submit" style="background:#27ae60; color:white; border:none; padding:6px 12px; border-radius:4px; cursor:pointer; font-weight:bold;">تعديل</button>
                </div>
            </form>
        </div>
    </div>

    <script>
    function openEditModal(id, title, pdfUrl, imageUrl, isTeacherOnly, categoryId) {
        document.getElementById('edit_id').value = id;
        document.getElementById('edit_title').value = title;
        document.getElementById('edit_pdf_url').value = pdfUrl;
        document.getElementById('edit_image_url').value = imageUrl;
        
        document.getElementById('edit_is_teacher_only').checked = (isTeacherOnly === true || isTeacherOnly === 'true');
        
        const categorySelect = document.getElementById('edit_category_id');
        if (categorySelect) {
            categorySelect.value = categoryId;
        }
        
        document.getElementById('editModal').style.display = 'flex';
    }

    function closeEditModal() { 
        document.getElementById('editModal').style.display = 'none'; 
    }

    function openEditCategoryModal(id, name) {
        document.getElementById('edit_cat_id').value = id;
        document.getElementById('edit_cat_name').value = name;
        document.getElementById('editCategoryModal').style.display = 'flex';
    }

    function closeEditCatModal() { 
        document.getElementById('editCategoryModal').style.display = 'none'; 
    }
    </script>
</body>
</html> -->
