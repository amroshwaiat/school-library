<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
     <link rel="icon" type="image/png" href="/images/favicon.png">
    <meta charset="UTF-8">
    <title>لوحة التحكم الرئيسية والبيانات ⚙️</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        html, body { margin: 0; padding: 0; box-sizing: border-box; background-color: #f5f6fa; font-family: system-ui, sans-serif; }
        header { background: #2c3e50; padding: 15px 20px; color: white; display: flex; align-items: center; justify-content: space-between; }
        header h1 { margin: 0; font-size: 1.5rem; }
        header nav { display: flex; gap: 15px; }
        header nav a { color: white; text-decoration: none; font-weight: bold; }

        .dashboard-container { display: flex; gap: 25px; padding: 25px; max-width: 1400px; margin: 0 auto; }
        .main-content { flex: 2.5; }
        .side-panel { flex: 1.2; }

        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 25px; }
        .stat-card { background: white; padding: 20px; border-radius: 12px; border: 1px solid #eee; text-align: center; box-shadow: 0 4px 10px rgba(0,0,0,0.02); }
        .stat-card h3 { margin: 0; color: #7f8c8d; font-size: 15px; }
        .stat-card p { margin: 10px 0 0 0; font-size: 30px; font-weight: bold; color: #2c3e50; }

        /* 🚀 بانر الانتقال السريع لإدارة الـ 200 كتاب بدون عجقة */
        .manage-books-banner { 
            background: linear-gradient(135deg, #27ae60, #1e824c); 
            color: white; padding: 30px; border-radius: 12px; text-align: center; margin-bottom: 25px; 
            box-shadow: 0 6px 15px rgba(39, 174, 96, 0.15);
        }
        .manage-books-banner h2 { margin: 0 0 8px 0; }
        .manage-books-banner p { margin: 0 0 20px 0; opacity: 0.9; font-size: 14px; }
        .manage-books-banner .btn-link { 
            display: inline-block; background: white; color: #27ae60; padding: 12px 30px; 
            text-decoration: none; border-radius: 8px; font-weight: bold; font-size: 16px; 
            transition: transform 0.2s; 
        }
        .manage-books-banner .btn-link:hover { transform: translateY(-2px); }

        .section-box { background: white; padding: 20px; border-radius: 12px; border: 1px solid #eee; margin-bottom: 25px; }
        .section-box h3 { margin-top: 0; color: #2c3e50; border-bottom: 2px solid #f1f2f6; padding-bottom: 10px; }

        .admin-table, .mini-table { width: 100%; border-collapse: collapse; background: white; }
        .admin-table th, .mini-table th { background: #2c3e50; color: white; padding: 12px; }
        .admin-table td, .mini-table td { padding: 12px; border-bottom: 1px solid #eeeff1; text-align: center; }

        .form-inline { display: flex; gap: 8px; margin-bottom: 15px; }
        .form-inline input { flex: 1; padding: 10px; border: 2px solid #dcdde1; border-radius: 6px; }
        .form-inline button { padding: 10px 20px; background: #27ae60; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; }

        @media (max-width: 950px) { .dashboard-container { flex-direction: column; } }
    </style>
</head>
<body>
    <header>
        <h1>لوحة تحكم الإدارة العامة للأنظمة ⚙️</h1>
        <nav>
            <a href="/">الموقع العام</a>
            <a href="/admin/users">إدارة الحسابات</a>
            <a href="/auth/logout" style="color: #ff7675;">تسجيل الخروج</a>
        </nav>
    </header>

    <div class="dashboard-container">
        <!-- الجزء الأيمن الرئيسي -->
        <main class="main-content">
            <div class="stats-grid">
               <div class="stats-grid">
    <div class="stat-card">
        <h3>📚 إجمالي الكتب المتوفرة</h3>
        <p><%= books.length %></p> 
    </div>
    <div class="stat-card">
        <h3>👥 الحسابات المسجلة بالنظام</h3>
        <p><%= users.length %></p>
    </div>
</div>
            </div>

            <!-- الكرت الذكي للانتقال المريح لإدارة الكتب -->
            <div class="manage-books-banner">
                <h2>إدارة محتوى ومستودع الكتب 📚</h2>
                <p>قم بالدخول إلى الصفحة المنفصلة المخصصة للتحكم بالـ  كتاب ، حيث يمكنك الإضافة، التعديل الفوري، والبحث الذكي.</p>
                <a href="/books/admin/books" class="btn-link">اضغط هنا للذهاب لإدارة الكتب الحالية ←</a>
            </div>

           
        </main>

        <!-- الجزء الأيسر المخصص للأقسام (BTEC) -->
        <aside class="side-panel">
            <div class="section-box">
                <h3>أقسام (BTEC) الحالية</h3>
                <form action="/books/categories/add" method="POST" class="form-inline">
                    <input type="text" name="category_name" placeholder="اسم القسم الجديد..." required>
                    <button type="submit">إضافة</button>
                </form>

                <table class="mini-table">
                    <thead>
                        <tr>
                            <th>اسم القسم العلمي</th>
                            <th>العمليات</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% categories.forEach(cat => { %>
                            <tr>
                                <td style="font-weight: 500; text-align: right;"><%= cat.name %></td>
                                <td>
                                    <button onclick="openEditCategoryModal('<%= cat.id %>', '<%= cat.name %>')" style="background:none; border:none; cursor:pointer; color:#f39c12;">✏️</button>
                                    <a href="/books/categories/delete/<%= cat.id %>" onclick="return confirm('حذف القسم سيؤدي لإزالة تصنيف الكتب المرتبطة به، هل أنت متأكد؟')" style="text-decoration:none; color:#e74c3c; margin-right:5px;">🗑️</a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </aside>
    </div>

    <!-- نافذة تعديل القسم المنبثقة Modal -->
    <div id="editCategoryModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 1000; justify-content: center; align-items: center;">
        <div style="background: white; padding: 25px; border-radius: 12px; width: 320px; box-shadow: 0 4px 15px rgba(0,0,0,0.2);">
            <h3 style="margin-top:0; color: #2c3e50;">تعديل اسم القسم</h3>
            <form action="/books/categories/edit" method="POST">
                <input type="hidden" name="id" id="edit_cat_id">
                <div style="margin-bottom: 15px;">
                    <input type="text" name="name" id="edit_cat_name" style="width: 100%; padding: 10px; border: 2px solid #ccc; border-radius: 6px;" required>
                </div>
                <div style="text-align: left;">
                    <button type="button" onclick="closeEditCatModal()" style="background:#95a5a6; color:white; border:none; padding:8px 14px; border-radius:4px; cursor:pointer; margin-left:5px;">إلغاء</button>
                    <button type="submit" style="background:#27ae60; color:white; border:none; padding:8px 14px; border-radius:4px; cursor:pointer;">تعديل</button>
                </div>
            </form>
        </div>
    </div>

    <script>
    function openEditCategoryModal(id, name) {
        document.getElementById('edit_cat_id').value = id;
        document.getElementById('edit_cat_name').value = name;
        document.getElementById('editCategoryModal').style.display = 'flex';
    }
    function closeEditCatModal() { document.getElementById('editCategoryModal').style.display = 'none'; }
       document.addEventListener('contextmenu', function(e) { e.preventDefault(); });
        document.addEventListener('keydown', function(e) {
            if (e.key === 'F12' || 
                (e.ctrlKey && e.shiftKey && ['I','J'].includes(e.key)) || 
                (e.ctrlKey && ['u','s'].includes(e.key))) {
                e.preventDefault();
                return false;
            }
        });
    </script>
</body>
</html>