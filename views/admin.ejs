    <title>لوحة تحكم الإدارة المتقدمة</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        /* 🌟 تصفير الهوامش لمنع الفراغات المزعجة أعلى الصفحة وفي أطرافها */
        html, body {
            margin: 0;
