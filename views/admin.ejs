</head>
<body>

    <header>
        <h1>لوحة تحكم مدير المكتبة ⚙️</h1>
        <nav>
            <a href="/">الموقع العام</a>
            <a href="/admin/users">إدارة الحسابات</a>
            <a href="/auth/logout" style="color: #ff7675;">تسجيل الخروج</a>
        </nav>
    </header>

    <div class="admin-container">
        <main class="main-content">
            
            <section class="form-section">
                <h3>إضافة كتاب جديد للموقع</h3>
                <form action="/books/add" method="POST">
                    <div class="form-group">
                        <label>عنوان الكتاب:</label>
                        <input type="text" name="title" placeholder="مثال: أساسيات البرمجة بلغة C++" required>
                    </div>
                    <div class="form-group">
                        <label>رابط الـ PDF للمعاينة (ينتهي بـ preview):</label>
                        <input type="text" name="pdf_url" placeholder="رابط الملف المخصص للمعاينة" required>
                    </div>
                    <div class="form-group">
                        <label>رابط صورة غلاف الكتاب:</label>
                        <input type="text" name="image_url" placeholder="رابط صورة الغلاف">
                    </div>
                    
                    <div class="form-group">
                        <label>القسم الرئيسي:</label>
                        <select name="category_id" id="add_category_id" required>
                            <option value="">-- اختر القسم العلمي --</option>
                            <% categories.forEach(cat => { %>
                                <option value="<%= cat.id %>"><%= cat.name %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>المستوى الدراسي (Level):</label>
                        <input type="text" name="level" placeholder="مثال: L2 أو L3 (اتركه فارغاً إذا لم يتوفر)" list="existing_levels">
                        <datalist id="existing_levels">
                            <option value="L2">
                            <option value="L3">
                        </datalist>
                    </div>

                    <div class="form-group">
                        <label>المادة الدراسية:</label>
                        <input type="text" name="subject_id" placeholder="مثال: تكنولوجيا المعلومات، البرمجة، أمن شبكات" required>
                    </div>

                    <label class="checkbox-container">
                        <input type="checkbox" name="is_teacher_only" value="true"> 
                        <span>جعل هذا كتاب ظاهراً للمعلمين فقط 🔐</span>
                    </label>

                    <button type="submit" style="background:#27ae60; color:white; border:none; padding:12px; border-radius:6px; font-weight:bold; cursor:pointer; width:100%; font-size:15px;">إضافة وحفظ في قاعدة البيانات</button>
                </form>
            </section>

            <h2>إدارة جميع الكتب الحالية (<%= books.length %> كتاب)</h2>
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>اسم الكتاب</th>
                        <th>القسم العلمي</th>
                        <th>المستوى والمادة</th>
                        <th>الفئة</th>
                        <th>العمليات</th>
                    </tr>
                </thead>
                <tbody>
                    <% books.forEach(book => { %>
                        <tr>
                            <td style="text-align: right; font-weight: bold; padding-right: 15px;"><%= book.title %></td>
                            <td><b style="color: #2980b9;"><%= book.category_name || 'غير مصنف' %></b></td>
                            <td>
                                <span style="color: #7f8c8d; font-size: 13px;">
                                    <%= book.level ? 'المستوى: ' + book.level : '' %> 
                                    <%= book.subject_id ? ' | مادة: ' + book.subject_id : '' %>
                                </span>
                            </td>
                            <td>
                                <span class="badge <%= book.is_teacher_only ? 'badge-teacher' : 'badge-all' %>">
                                    <%= book.is_teacher_only ? 'معلمين فقط' : 'عام للجميع' %>
                                </span>
                            </td>
                            <td>
                                <button onclick="openEditModal('<%= book.id %>', '<%= book.title %>', '<%= book.pdf_url %>', '<%= book.image_url %>', <%= book.is_teacher_only %>, '<%= book.category_id || '' %>', '<%= book.level || '' %>', '<%= book.subject_id || '' %>')" style="background: #f39c12; color:white; border:none; padding:6px 12px; border-radius:4px; cursor:pointer; font-weight: bold;">تعديل 📝</button>
                                <a href="/books/delete/<%= book.id %>" onclick="return confirm('هل أنت متأكد من حذف هذا الكتاب نهائياً؟')" style="background: #e74c3c; color:white; padding:6px 12px; text-decoration:none; border-radius:4px; display:inline-block; font-weight: bold; margin-right: 5px;">حذف 🗑️</a>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </main>

        <aside class="side-panel">
            <h3>إدارة الأقسام (BTEC)</h3>
            <form action="/books/categories/add" method="POST" style="display: flex; gap: 5px; margin-bottom: 15px;">
                <input type="text" name="category_name" placeholder="اسم القسم الجديد..." style="flex: 1; padding:8px; border:1px solid #ccc; border-radius:4px;" required>
                <button type="submit" style="padding:8px 12px; background:#27ae60; color:white; border:none; border-radius:4px; cursor:pointer; font-weight:bold;">إضافة</button>
            </form>

            <table class="mini-table">
                <thead>
                    <tr style="background: #f2f2f2;">
                        <th>اسم القسم</th>
                        <th>العمليات</th>
                    </tr>
                </thead>
                <tbody>
                    <% categories.forEach(cat => { %>
                        <tr>
                            <td style="font-weight: 500;"><%= cat.name %></td>
                            <td>
                                <button onclick="openEditCategoryModal('<%= cat.id %>', '<%= cat.name %>')" style="background:none; border:none; cursor:pointer; color:#f39c12; font-size:16px;">✏️</button>
                                <a href="/books/categories/delete/<%= cat.id %>" onclick="return confirm('حذف القسم سيؤدي لإزالة تصنيف الكتب المرتبطة به، هل أنت متأكد؟')" style="text-decoration:none; color:#e74c3c; font-size:14px; margin-right:5px;">🗑️</a>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </aside>
    </div>

    <div id="editModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 1000; justify-content: center; align-items: center;">
        <div style="background: white; padding: 25px; border-radius: 12px; width: 480px; direction: rtl; box-shadow: 0 4px 15px rgba(0,0,0,0.2); max-height: 90vh; overflow-y: auto;">
            <h3 style="margin-top: 0; border-bottom: 2px solid #eee; padding-bottom: 10px;">تعديل بيانات الكتاب</h3>
            <form id="editForm" action="/books/edit" method="POST">
                <input type="hidden" name="id" id="edit_id">
                
                <div class="form-group">
                    <label>عنوان الكتاب:</label>
                    <input type="text" name="title" id="edit_title" required>
                </div>
                <div class="form-group">
                    <label>رابط الـ PDF للمعاينة:</label>
                    <input type="text" name="pdf_url" id="edit_pdf_url" required>
                </div>
                <div class="form-group">
                    <label>رابط غلاف الكتاب:</label>
                    <input type="text" name="image_url" id="edit_image_url" >
                </div>
                
                <div class="form-group">
                    <label>القسم العلمي:</label>
                    <select name="category_id" id="edit_category_id" required>
                        <% categories.forEach(cat => { %>
                            <option value="<%= cat.id %>"><%= cat.name %></option>
                        <% }) %>
                    </select>
                </div>

                <div class="form-group">
                    <label>المستوى الدراسي (Level):</label>
                    <input type="text" name="level" id="edit_level" placeholder="مثال: L2 أو L3">
                </div>

                <div class="form-group">
                    <label>المادة الدراسية:</label>
                    <input type="text" name="subject_id" id="edit_subject_id" placeholder="اسم المادة" required>
                </div>
                
                <label class="checkbox-container">
                    <input type="checkbox" name="is_teacher_only" id="edit_is_teacher_only" value="true"> 
                    <span>جعل هذا الكتاب ظاهراً للمعلمين فقط 🔐</span>
                </label>
                
                <div style="text-align: left; margin-top: 20px; border-top: 1px solid #eee; padding-top: 15px;">
                    <button type="button" onclick="closeEditModal()" style="background:#95a5a6; color:white; border:none; padding:8px 15px; border-radius:4px; cursor:pointer; font-weight:bold; margin-left:5px;">إلغاء</button>
                    <button type="submit" style="background:#27ae60; color:white; border:none; padding:8px 15px; border-radius:4px; cursor:pointer; font-weight:bold;">حفظ التعديلات</button>
                </div>
            </form>
        </div>
    </div>

    <div id="editCategoryModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 1000; justify-content: center; align-items: center;">
        <div style="background: white; padding: 20px; border-radius: 8px; width: 300px; direction: rtl; box-shadow: 0 4px 15px rgba(0,0,0,0.2);">
            <h3>تعديل اسم القسم</h3>
            <form action="/books/categories/edit" method="POST">
                <input type="hidden" name="id" id="edit_cat_id">
                <div class="form-group">
                    <input type="text" name="name" id="edit_cat_name" required>
                </div>
                <div style="text-align: left; margin-top: 15px;">
                    <button type="button" onclick="closeEditCatModal()" style="background:#95a5a6; color:white; border:none; padding:6px 12px; border-radius:4px; cursor:pointer;">إلغاء</button>
                    <button type="submit" style="background:#27ae60; color:white; border:none; padding:6px 12px; border-radius:4px; cursor:pointer; font-weight:bold;">تعديل</button>
                </div>
            </form>
        </div>
    </div>

    <script>
    // تحديث دالة فتح الـ Modal لتستقبل وتعرض متغيرات الـ Level والـ Subject الجديدة
    function openEditModal(id, title, pdfUrl, imageUrl, isTeacherOnly, categoryId, level, subjectId) {
        document.getElementById('edit_id').value = id;
        document.getElementById('edit_title').value = title;
        document.getElementById('edit_pdf_url').value = pdfUrl;
        document.getElementById('edit_image_url').value = imageUrl;
        document.getElementById('edit_level').value = level;
        document.getElementById('edit_subject_id').value = subjectId;
        
        document.getElementById('edit_is_teacher_only').checked = (isTeacherOnly === true || isTeacherOnly === 'true');
        
        const categorySelect = document.getElementById('edit_category_id');
        if (categorySelect) {
            categorySelect.value = categoryId;
        }
        
        document.getElementById('editModal').style.display = 'flex';
    }

    function closeEditModal() { 
        document.getElementById('editModal').style.display = 'none'; 
    }

    function openEditCategoryModal(id, name) {
        document.getElementById('edit_cat_id').value = id;
        document.getElementById('edit_cat_name').value = name;
        document.getElementById('editCategoryModal').style.display = 'flex';
    }

    function closeEditCatModal() { 
        document.getElementById('editCategoryModal').style.display = 'none'; 
    }
    </script>
</body>
